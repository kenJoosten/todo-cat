{
  "name": "todo-cat-cli",
  "version": "0.1.0",
  "private": true,
  "description": "The todo-cat command-line client, for AI agents and their humans.",
  "type": "module",
  "bin": {
    "todo-cat": "dist/todo-cat.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --external:commander --external:zod --outfile=dist/todo-cat.js --log-level=warning",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@todo-cat/contract": "0.1.0",
    "commander": "15.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
